{
  "name": "dsh-provenance",
  "version": "0.1.0",
  "description": "Pre-install supply-chain provenance checks for DeepSeek Harness plugins: verify the tarball you're about to install matches the source you read, before any code runs. Never executes the audited package.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "supply-chain",
    "supply-chain-security",
    "provenance",
    "security",
    "sigstore",
    "integrity",
    "npm-provenance"
  ],
  "license": "MIT",
  "author": "Darren Tang",
  "homepage": "https://github.com/Darren-Tang/dsh-provenance#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Darren-Tang/dsh-provenance.git"
  },
  "bugs": {
    "url": "https://github.com/Darren-Tang/dsh-provenance/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "bin": {
    "dsh-provenance": "lib/cli.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:core": "tsc -p tsconfig.core.json",
    "typecheck": "tsc -p tsconfig.core.json --noEmit",
    "typecheck:all": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build:core && node --test test/*.test.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0-rc.7 || ^4",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "@types/node": "^22.15.0",
    "typescript": "^5.7.0"
  }
}
